<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1015"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <!-- Título Principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mapper Control TV"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personaliza los accesos de tu control Chromecast"
            android:textColor="#8C92A4"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Tarjeta de Configuración -->
        <LinearLayout
            android:layout_width="500dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1C1E26"
            android:padding="24dp"
            android:elevation="4dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Selecciona el Botón del Control"
                android:textColor="#3DDC84"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/buttonSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#282B36"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Selecciona el Tipo de Gesto"
                android:textColor="#3DDC84"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/gestureSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#282B36"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Acción a Ejecutar (Sistema o Aplicación)"
                android:textColor="#3DDC84"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/actionSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#282B36"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Guardar Configuración de Mapeo"
                android:backgroundTint="#6200EE"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botón de Activación de Accesibilidad -->
        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="350dp"
            android:layout_height="50dp"
            android:text="Activar Servicio de Accesibilidad"
            android:backgroundTint="#03DAC5"
            android:textColor="#000000"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
