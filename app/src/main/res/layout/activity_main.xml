<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#121212"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mapeador de Botones Chromecast TV"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona la acción para 3 toques en 'Subir Volumen':"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Spinner
        android:id="@+id/actionSpinner"
        android:layout_width="400dp"
        android:layout_height="50dp"
        android:background="#2C2C2C"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="Guardar Configuración"
        android:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="Activar Servicio en Ajustes"
        android:backgroundTint="#03DAC5"
        android:textColor="#000000" />

</LinearLayout>
